# ---- App ----
APP_NAME="Supplement Desk"
APP_URL="http://localhost:3000"

# First admin account, created on first start if no users exist.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# ---- Database ----
# Leave empty to use an embedded Postgres (PGlite) stored in ./data — zero setup for local use.
# Set to a real Postgres URL for production (e.g. Cloud SQL).
DATABASE_URL=""

# ---- Files ----
# Where the embedded database and local files live.
DATA_DIR="./data"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty in development, a key is generated and saved in DATA_DIR/.filekey.
FILE_ENCRYPTION_KEY=""
# Set to a bucket name to store (encrypted) files in Google Cloud Storage instead of local disk.
GCS_BUCKET=""

# ---- AI ----
# Without a key the app drafts supplements from the rules library alone (no photo or PDF reasoning).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ---- Email ----
# e.g. smtps://user:pass@smtp.example.com:465 — without it, emails are recorded in Admin > Outbox only.
SMTP_URL=""
MAIL_FROM="Supplement Desk <no-reply@example.com>"

# ---- Email intake (optional) ----
# Domain of your inbound mail provider (Postmark inbound format). Shops forward to intake+<token>@<domain>.
INBOUND_EMAIL_DOMAIN=""
INBOUND_WEBHOOK_SECRET=""

# ---- Workflow ----
# true = assign each new job to the estimator with the fewest open jobs
AUTO_ASSIGN="false"
APP_TIMEZONE="America/Chicago"
